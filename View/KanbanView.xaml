<Window x:Class="ProjectManager.View.KanbanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KanbanView" WindowState="Maximized" Width="800"
        Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#1E1E1E" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Button Content="Back" Height="30" Click="BackButton"
                    Grid.Row="0" Grid.Column="0"
                    Background="#1E1E1E" Foreground="White"
                    FontSize="16" FontWeight="Bold" BorderBrush="#1E1E1E"/>

            <TextBlock Style="{StaticResource UnderlinedText}" FontSize="24"
                       Grid.ColumnSpan="3" Grid.Row="0" HorizontalAlignment="Center">
                <Run Text="Project : "/>
                <Run Text="{Binding CurrentProject.Title}"/>
            </TextBlock>

            <!-- Colonnes -->
            <StackPanel Grid.Column="0" Grid.Row="1">
                <TextBlock Text="To Do" Foreground="White" FontSize="24"/>
                <ListBox ItemsSource="{Binding ToDoTasks}"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="800"
                         DragOver="Kanban_DragOver"
                         Drop="ToDo_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="White" BorderThickness="1" CornerRadius="5"
                                    Padding="10" Margin="0,10,0,10"
                                    PreviewMouseLeftButtonDown="Task_Drag">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- In Progress -->
            <StackPanel Grid.Column="1" Grid.Row="1">
                <TextBlock Text="In Progress" Foreground="White" FontSize="24"/>
                <ListBox ItemsSource="{Binding InProgressTasks}"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="800"
                         DragOver="Kanban_DragOver"
                         Drop="InProgress_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Orange" BorderThickness="1" CornerRadius="5"
                                    Padding="10" Margin="0,10,0,10"
                                    PreviewMouseLeftButtonDown="Task_Drag">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Done -->
            <StackPanel Grid.Column="2" Grid.Row="1">
                <TextBlock Text="Done" Foreground="White" FontSize="24"/>
                <ListBox ItemsSource="{Binding DoneTasks}"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="800"
                         DragOver="Kanban_DragOver"
                         Drop="Done_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Green" BorderThickness="1" CornerRadius="5"
                                    Padding="10" Margin="0,10,0,10"
                                    PreviewMouseLeftButtonDown="Task_Drag">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
