<Window x:Class="ProjectManager.View.ProjectCreatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManager.View"
        mc:Ignorable="d"
        Title="ProjectCreatorView" Height="450" Width="800"
        Background="#1E1E1E"
        Icon="pack://application:,,,/Assets/PML.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Create a new Project :" Grid.Column="0" Grid.Row="0" FontSize="24" Style="{StaticResource UnderlinedText}"/>
        <Label Content="Title of the Project : " Grid.Column="0" Grid.Row="1" Margin="0, 35" FontSize="18" Style="{StaticResource LabelStyle}"/>
        <Label Content="Description of the Project :" Grid.Column="0" Grid.Row="1" FontSize="18" Margin="-5,106,5,83" Style="{StaticResource LabelStyle}" Grid.RowSpan="2"/>
        <Label Content="Leader of the Project :" Grid.Column="0" Grid.Row="2" FontSize="18" Margin="-5,156,5,33" Style="{StaticResource LabelStyle}" Grid.RowSpan="2"/>
        <TextBox Text="{Binding ProjectTitle}" Grid.Column="1" Grid.Row="1" Margin="0, 30, 50, 30" Style="{StaticResource ModernTextBox}"/>
        <TextBox Text="{Binding ProjectDesc}" Grid.Column="1" Grid.Row="1" Margin="0,106,133,83" Style="{StaticResource ModernTextBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
        <TextBox Text="{Binding ProjectLeader}" Grid.Column="1" Grid.Row="2" Margin="0,156,50,15" Style="{StaticResource ModernTextBox}"/>
        <Button Grid.Column="1" Grid.Row="3" Style="{StaticResource RoundedButton}" Content="Create" Margin="100, 15" Command="{Binding CreateProjectCommand}"/>
    </Grid>
</Window>
