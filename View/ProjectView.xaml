<Window x:Class="ProjectManager.View.ProjectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManager.View"
        xmlns:conv="clr-namespace:ProjectManager.Converters"
        mc:Ignorable="d"
        Title="Project" Height="450" Width="800" WindowState="Maximized"
        Background="#1E1E1E"
        Icon="pack://application:,,,/Assets/PML.ico">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="Back" Height="30" Click="BackButton_Click" Grid.Row="0" Grid.Column="0" Background="#1E1E1E" Foreground="White" FontSize="16" FontWeight="Bold" FontStyle="Oblique" Margin="0,4,49,28" BorderBrush="#1E1E1E"/>
            <TextBlock Style="{StaticResource UnderlinedText}" FontSize="24" Grid.Column="1">
                <Run Text="Project : "/>
                <Run Text="{Binding CurrentProject.Title}"/>
            </TextBlock>
            <TextBlock FontSize="24" FontWeight="Bold" FontStyle="Oblique" Foreground="White" Grid.Row="0" Grid.Column="2">
                <Run Text="Progress : "/>
                <Run Text="{Binding ProgressPercentage, Mode=OneWay, StringFormat={}{0:F0}%}"/>
            </TextBlock>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" Height="20" Grid.Row="0" Grid.Column="2" Margin="132,40,10,10" Background="#333" Foreground="Green"/>
            <Button Content="Create an Epic" Grid.Row="1" Grid.Column="0" Width="90" Height="30" Style="{StaticResource RoundedButton}" Margin="5,10,5,320" Command="{Binding CreateEpicCommand}"/>
            <Button Content="Kanban View" Command="{Binding OpenKanbanCommand}" Style="{StaticResource RoundedButton}" Grid.Column="1" Height="30" Width="90" RenderTransformOrigin="0.509,1.611" Margin="0,35,138,5"/>


            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,60,0,280" Visibility="{Binding SelectedEpic, Converter={StaticResource NullToVisibility}}">
                <Button Content="Delete Epic" Command="{Binding DeleteEpicCommand}" CommandParameter="{Binding SelectedEpic}" Style="{StaticResource RoundedButton}"
                        Height="30" Width="90"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,100,0,240" Visibility="{Binding SelectedUS, Converter={StaticResource NullToVisibility}}">
                <Button Content="Delete User Story" Command="{Binding DeleteUSCommand}" CommandParameter="{Binding SelectedUS}" Style="{StaticResource RoundedButton}"
                        Height="30" Width="90"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,140,0,200" Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibility}}">
                <Button Content="Delete Task" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedTask}" Style="{StaticResource RoundedButton}"
                        Height="30" Width="90"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                <TextBlock Text="Navigation" Style="{StaticResource UnderlinedText}"/>

                <ItemsControl ItemsSource="{Binding Epics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>

                                <Button Content="{Binding Title}"
                        Command="{Binding DataContext.SelectEpicCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource EpicButtonStyle}"
                        Margin="0,5,0,5"
                        Width="120" HorizontalAlignment="Left"/>

                                <ItemsControl ItemsSource="{Binding Stories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="20,0,0,0">
                                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.SelectUSCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource USButtonStyle}"
                                        Width="120" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                                <ItemsControl ItemsSource="{Binding Tasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Une ligne pour chaque tâche -->
                                                            <Grid Margin="20,5,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Bouton -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Point -->
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Bouton de la tâche -->
                                                                <Button x:Name="TaskButton"
                        Grid.Column="0"
                        Content="{Binding Title}"
                        Command="{Binding DataContext.SelectTaskCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource TaskButtonStyle}"
                        Width="120"
                        HorizontalAlignment="Left"/>

                                                                <!-- Point rouge juste à côté du bouton -->
                                                                <Ellipse Grid.Column="1"
                         Width="10" Height="10"
                         Margin="8,0,0,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding isLate}" Value="True">
                                                                                    <Setter Property="Fill" Value="Red"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>



                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </StackPanel>
            <Grid Grid.Column="2" Grid.Row="1" Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Epic -->
                    <RowDefinition Height="Auto"/>
                    <!-- User Story -->
                    <RowDefinition Height="Auto"/>
                    <!-- Task -->
                </Grid.RowDefinitions>

                <!-- EPIC DETAILS -->
                <StackPanel Grid.Row="0"
                Visibility="{Binding SelectedEpic, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource UnderlinedText}" FontSize="24">
                        <Run Text="Epic : "/>
                        <Run Text="{Binding SelectedEpic.Title}"/>
                    </TextBlock>

                    <Button Content="Create a User Story"
                Command="{Binding CreateUSCommand}"
                Style="{StaticResource RoundedButton}"
                HorizontalAlignment="Right"
                Height="30" Width="150"/>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Description of the Epic : "/>
                        <Run Text="{Binding SelectedEpic.Description}"/>
                    </TextBlock>
                </StackPanel>


                <!-- USER STORY DETAILS -->
                <StackPanel Grid.Row="1"
                Visibility="{Binding SelectedUS, Converter={StaticResource NullToVisibility}}">
                    <TextBlock FontSize="20" Foreground="White">
                        <Run Text="User Story : "/>
                        <Run Text="{Binding SelectedUS.Title}"/>
                    </TextBlock>

                    <Button Content="Create a Task"
                Command="{Binding CreateTaskCommand}"
                Style="{StaticResource RoundedButton}"
                HorizontalAlignment="Right"
                Height="30" Width="150"/>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Description of the User Story : "/>
                        <Run Text="{Binding SelectedUS.Description}"/>
                    </TextBlock>
                </StackPanel>


                <!-- TASK DETAILS -->
                <StackPanel Grid.Row="2" Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibility}}">
                    <TextBlock FontSize="16" Foreground="White">
                        <Run Text="Task : "/>
                        <Run Text="{Binding SelectedTask.Title}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Description of the Task : "/>
                        <Run Text="{Binding SelectedTask.Description}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Estimated Time (hours) : "/>
                        <Run Text="{Binding SelectedTask.TempsEstime}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Due Date : "/>
                        <Run Text="{Binding SelectedTask.Echeance}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Priority : "/>
                        <Run Text="{Binding SelectedTask.Importance}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="White">
                        <Run Text="Owner : "/>
                        <Run Text="{Binding SelectedTask.Owner}"/>
                    </TextBlock>

                    <CheckBox Content="Task Completed" IsChecked="{Binding SelectedTask.IsCompletedTask}" Foreground="White" HorizontalAlignment="Right" Checked="TaskCompleted_Checked" Unchecked="TaskCompleted_Unchecked"/>
                </StackPanel>

            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
